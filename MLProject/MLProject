name: poker-hand-classification
conda_env: conda.yaml

entry_points:
  main:
    parameters:
      n_estimators:
        type: int
        default: 200
      max_depth:
        type: int
        default: 15
      min_samples_split:
        type: int
        default: 5
      min-accuracy:
        type: float
        default: 0.70
    command: python modelling.py --n-estimators {n_estimators} --max-depth {max_depth} --min-samples-split {min_samples_split} --data-dir pokerhand_preprocessing --min-accuracy {min-accuracy}
